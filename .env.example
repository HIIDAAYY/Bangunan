# --- Provider AI untuk ekstraksi pesanan ---
# claude (default) | openrouter (mis. model gratis) | heuristik (tanpa AI, hanya demo/test)
EXTRACTOR=claude

# Claude (Anthropic API)
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium

# OpenRouter (dipakai bila EXTRACTOR=openrouter)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free,dots-studio/dots-3-note-preview:free   (beberapa model = fallback)

# --- Twilio WhatsApp Sandbox ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Nomor sandbox Twilio, dengan prefix whatsapp:
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Database ---
# Lokal (npm run db:local):
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/asisten_pesanan
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/asisten_pesanan
# Supabase (Project Settings > Database > Connection string):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Aplikasi ---
# URL publik aplikasi (ngrok atau Vercel). Dipakai untuk validasi signature Twilio & link nota PDF.
PUBLIC_BASE_URL=http://localhost:3000
# Rahasia untuk menandatangani link nota PDF (string acak panjang)
APP_SECRET=ganti-dengan-string-acak
# Login dashboard (HTTP Basic Auth, username: admin)
DASHBOARD_PASSWORD=ganti-password
